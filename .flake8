[flake8]
inline-quotes = "
ignore = E203, E266, W503, N807, N818, F401
max-line-length = 79
max-complexity = 18
select = B,C,E,F,W,T4,B9,Q0,N8,VNE
exclude =
    **migrations
    venv
    .venv
    tests
    ENV,env,__pycache__,.git,.tox,.eggs,*.egg,site-packages,
    Lib/site-packages,lib/site-packages,*/site-packages/*
